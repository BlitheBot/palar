{
  "name": "palar",
  "version": "0.4.1",
  "description": "Defensive, read-only static analyzer for local MCP tool and server definition files",
  "type": "module",
  "bin": {
    "palar": "dist/cli/index.js"
  },
  "main": "./dist/cli/index.js",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.map",
    "docker",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BlitheBot/palar.git"
  },
  "bugs": {
    "url": "https://github.com/BlitheBot/palar/issues"
  },
  "homepage": "https://github.com/BlitheBot/palar#readme",
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build && npm test",
    "dev": "tsx src/cli/index.ts",
    "test": "tsc -p tsconfig.json && node --test \"dist/**/*.test.js\"",
    "typecheck": "tsc --noEmit",
    "demo:scan": "node scripts/demo-scan.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "security",
    "static-analysis",
    "audit"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "fast-glob": "^3.3.2"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "zod": "^4.4.3"
  }
}
